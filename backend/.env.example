DATABASE_URL="postgresql://app:app@localhost:5433/pedidos?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:5173"
# Minutos que tiene el cliente para pagar antes de que el pedido expire (fase 4)
PAYMENT_DEADLINE_MINUTES=15


